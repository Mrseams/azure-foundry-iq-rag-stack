# Copy to .env (never commit it). Used by provision.sh; the same names suit the application's own settings.

# Prefix of the Search object names: <APP>-documents, <APP>-documents-indexer, <APP>-kb...
APP=myapp

# Storage: the app's documents container
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER=myapp-documents
# Set it to let the indexer read Blob with the Search managed identity (Storage Blob Data Reader) instead of the account key
AZURE_STORAGE_RESOURCE_ID=
# Only when the app reaches Blob through a gateway that strips a path prefix (the app then signs a container SAS)
AZURE_STORAGE_GATEWAY_URL=

# Azure AI Search (admin key)
AZURE_SEARCH_ENDPOINT=https://<search-name>.search.windows.net
AZURE_SEARCH_KEY=

# Azure AI Foundry / Azure OpenAI
# What the app calls (can be a gateway URL)
AZURE_OPENAI_ENDPOINT=https://<foundry-name>.openai.azure.com
# What Search calls, from inside Azure: always the resource's own URL
AZURE_OPENAI_RESOURCE_URL=https://<foundry-name>.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# OCR billing: the same Foundry resource, through its cognitiveservices endpoint; the key defaults to AZURE_OPENAI_KEY
AZURE_AI_SERVICES_URL=https://<foundry-name>.cognitiveservices.azure.com
AZURE_AI_SERVICES_KEY=

# How Foundry IQ should search your corpus: document types, languages, how questions are asked
RETRIEVAL_INSTRUCTIONS="The documents are laws, regulations, internal policies, past judgments and case files, in French or English. Search in both languages when it helps. When the question comes with a case context, use its facts to search for the applicable rules and the case's own documents."
